@startuml
title Login

actor User
participant "System" as S
participant "Google OAuth" as G
database "Database" as DB

alt Google SSO
    User -> S : Clicks "Continue with Google"
    S -> G : Redirect to Google auth
    G --> User : Account selection screen
    User -> G : Selects account
    G --> S : Returns id_token
    S -> G : Verifies id_token
    G --> S : { email, name, avatar }
    S -> DB : Search user by email
    DB --> S : Result

    alt First time (no account found)
        S -> DB : Create user record\n{ email, nickname, avatar_url }
        DB --> S : User created
        S -> DB : Update last_active_at
        DB --> S : ok
        S -> S : Generate signed JWT
        S --> User : Redirect to dashboard
    else Account exists
        S -> DB : Update last_active_at
        DB --> S : ok
        S -> S : Generate signed JWT
        S --> User : Redirect to dashboard
    end

else Email / Password
    User -> S : Submits email + password
    S -> DB : Search user by email
    DB --> S : { password_hash }
    S -> S : Validate password (bcrypt)

    alt Invalid credentials
        S --> User : Show error message
    else Valid credentials
        S -> DB : Update last_active_at
        DB --> S : ok
        S -> S : Generate signed JWT
        S --> User : Redirect to dashboard
    end
end

@enduml