@startuml task_module
!include style.puml
package "Modules::Task" {
  class TaskController <<controller>> {
    + Elysia()
    + post('/tasks', createTaskHandler)
    + get('/tasks', listTasksHandler)
    + get('/tasks/:id', getTaskHandler)
    + patch('/tasks/:id', updateTaskHandler)
    + patch('/tasks/:id/complete', completeTaskHandler)
    + delete('/tasks/:id', deleteTaskHandler)
    + get('/tasks/trash', listTrashHandler)
    + post('/tasks/:id/restore', restoreTaskHandler)
  }

  class TaskModel <<schema>> {
    + CreateTaskSchema : t.Object
    + UpdateTaskSchema : t.Object
    + TaskFilterSchema : t.Object
    + RecurrenceSchema : t.Object
  }

  class TaskService <<service>> {
    {static} + createTask(userId: UUID, data: CreateTaskSchema, assignedBy: UUID?)
    {static} + updateTask(taskId: UUID, data: UpdateTaskSchema)
    {static} + completeTask(taskId: UUID, completionDate: DateTime)
    {static} + moveToTrash(taskId: UUID)
    {static} + restoreFromTrash(taskId: UUID)
    {static} + purgeExpiredTrash()
    {static} + getPendingTasks(userId: UUID, filters: TaskFilterSchema)
    {static} + getTrashedTasks(userId: UUID)
    {static} + generateRecurringInstances(recurrence: Recurrence, fromDate: Date)
  }

  class Task <<domain>> {
    - id : UUID
    - userId : UUID
    - assignedBy : UUID
    + title : String
    + description : String
    + type : TaskType
    + estimatedTimeMinutes : int
    + startTime : DateTime
    + dueDate : DateTime
    + completionDate : DateTime
    + deletedAt : DateTime
    + priority : Priority
    + status : TaskStatus
    + tags : List<String>
  }

  class Recurrence <<domain>> {
    + id : UUID
    + taskId : UUID
    + frequency : RecurrenceFrequency
    + interval : int
    + daysOfWeek : List<int>
    + endDate : DateTime
    + nextOccurrence : DateTime
  }

  class TaskRepository <<infrastructure>> {
    + save(task: Task) : void
    + update(task: Task) : void
    + findById(id: UUID) : Task
    + findByUserId(uid: UUID) : List<Task>
    + findTrashedTasks(uid: UUID) : List<Task>
    + findExpiredTrash(beforeDate: DateTime) : List<Task>
    + saveRecurrence(recurrence: Recurrence) : void
  }

  enum Priority {
    HIGH
    MEDIUM
    LOW
  }
  enum TaskType {
    TASK
    MEETING
    EVENT
  }
  enum TaskStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    DELETED
  }
  enum RecurrenceFrequency {
    DAILY
    WEEKLY
    MONTHLY
  }

  TaskController --> TaskService : uses >
  TaskController --> TaskModel : validates with >
  TaskService --> TaskRepository : uses >
  Task "1" *-l- "0..1" Recurrence : recurring >
  TaskRepository .l.> Task : manages >
  Recurrence --> RecurrenceFrequency
  Task --> Priority
  Task --> TaskType
  Task --> TaskStatus
}

package "Modules::Gamification" <<external>> {
  class GamificationService <<external>>
}
package "Modules::Notification" <<external>> {
  class NotificationService <<external>>
}

TaskService ..> GamificationService : awards XP if completionDate <= dueDate >
TaskService ..> NotificationService : sends alerts >

package "Modules::User" <<external>> {
  class User <<external>>
}

User "1" --> "0..*" Task : creates >
@enduml