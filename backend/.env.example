# Local development example values only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/altoke
JWT_SECRET=replace-with-local-dev-secret
GOOGLE_CLIENT_ID=

# Public frontend URL used in password-reset links. Use the appropriate value per environment.
APP_BASE_URL=https://altoke.qzz.io

# Transactional email (Brevo SMTP example). Keep SMTP_PASSWORD out of version control.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@altoke.qzz.io
EMAIL_FROM_NAME=AlToke
